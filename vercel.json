{
  "version": 2,
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    },
    {
      "source": "/frontend/assets/:path*",
      "destination": "/frontend/assets/:path*"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/index.html"
    }
  ]
}
